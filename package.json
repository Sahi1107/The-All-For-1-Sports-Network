{
  "name": "allfor1-network",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace=apps/server && npm run build --workspace=apps/web",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "prepare": "bash scripts/install-hooks.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
