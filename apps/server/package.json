{
  "name": "allfor1-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "db:migrate": "prisma migrate deploy",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "node --require ts-node/register --test 'src/**/*.test.ts'",
    "create-admin": "ts-node --project tsconfig.json scripts/create-admin.ts",
    "seed:mock": "ts-node --project tsconfig.json scripts/seed-mock-profiles.ts"
  },
  "dependencies": {
    "@af1/validation": "*",
    "@af1/core": "*",
    "@anthropic-ai/sdk": "^0.82.0",
    "@google-cloud/storage": "^7.19.0",
    "@prisma/client": "^6.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.68.0",
    "@types/nodemailer": "^7.0.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.3",
    "satori": "^0.29.0",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "zod": "^4.3.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
