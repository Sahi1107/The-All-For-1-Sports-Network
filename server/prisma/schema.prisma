generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ATHLETE
  COACH
  SCOUT
  TEAM
  AGENT
  MEDIA
  ADMIN
  // Tournament organiser. This is an IDENTITY label only — it grants NO
  // platform-wide powers by itself. All organiser powers are scoped to the
  // specific tournaments the user is assigned to via TournamentOrganizer, and
  // enforced by middleware/tournamentAccess.ts. New organiser-only accounts get
  // this role; existing users keep their own role and gain scoped access via an
  // assignment. ADMIN remains platform-wide and separate.
  ORGANIZER
}

enum Sport {
  BASKETBALL
  FOOTBALL
  CRICKET
  FIELD_HOCKEY
  BADMINTON
  ATHLETICS
  WRESTLING
  BOXING
  SHOOTING
  WEIGHTLIFTING
  ARCHERY
  TENNIS
  TABLE_TENNIS
  RUGBY
  SWIMMING
  VOLLEYBALL
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TournamentStatus {
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  TEAM
  INDIVIDUAL
  DOUBLES
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

enum TrackerBracketFormat {
  LEAGUE
  KNOCKOUT
  MIXED
}

enum TrackerMatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  PUBLISHED
}

enum TeamMemberRole {
  CAPTAIN
  PLAYER
  COACH
}

enum TeamMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AnnouncementType {
  TRIAL
  TRAINING
  GENERAL
}

enum NotificationType {
  FOLLOW
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  TOURNAMENT_UPDATE
  TEAM_INVITE
  TEAM_JOIN_REQUEST
  RANKING_UPDATE
  HIGHLIGHT_VIEW
  ANNOUNCEMENT
  SYSTEM
  LIKE
  COMMENT
  REPOST
  MESSAGE
  ENDORSEMENT
  // ── High-value additions (channel-agnostic; see notificationCatalog.ts) ──
  PROFILE_VIEW // a scout/coach viewed your profile (collapsed)
  PROFILE_VIEWS_WEEKLY // weekly "your profile got N views" digest
  STATS_VERIFIED // your stats were verified / Performance Card updated
  RANKING_MILESTONE // entered a top-N / crossed a meaningful threshold
  MATCH_STARTING_SOON // your team's match starts soon
  MATCH_RESULT_PUBLISHED // your match result (incl. your stats) is live
  REGISTRATION_OPEN // a tournament you're eligible for opened registration
  REGISTRATION_CLOSING // registration for a tournament closes soon
  DRAW_PUBLISHED // a tournament draw/bracket was published
  FIXTURES_SCHEDULED // your team's fixtures were scheduled
  NEW_ATHLETE_MATCH // (scout) an athlete matching your interests joined
}

enum DigestFrequency {
  INSTANT
  DAILY
  WEEKLY
  OFF
}

enum InviteKind {
  GENERAL // personal "join me on All For 1"
  TEAMMATE // join my team
  COACH // I'd like you to coach / see my athletes
  ATHLETE // join as an athlete
  TOURNAMENT // join this tournament
}

enum PostType {
  TEXT
  IMAGE
  HIGHLIGHT
  PERFORMANCE
}

enum HandoverStatus {
  NONE // no handover in progress
  PENDING // consent email sent, awaiting guardian decision
  CONSENTED // guardian accepted; athlete may set their own credentials
}

// Guardian consent for an admin/bulk-created under-13 account.
enum GuardianConsentStatus {
  PENDING // consent email sent; no credentials issued yet
  CONSENTED // guardian approved; welcome + login credentials delivered
}

// Used to separate men's and women's rankings (and gender-specific weight classes).
enum Gender {
  MALE
  FEMALE
}

// ─── User ────────────────────────────────────────────────

model User {
  id                     String    @id @default(uuid())
  firebaseUid            String?   @unique @map("firebase_uid")
  email                  String    @unique
  name                   String
  role                   Role
  sport                  Sport?
  gender                 Gender?
  athleticsEvents        String[]  @map("athletics_events")
  avatar                 String?
  bio                    String?
  location               String?
  // Structured location, parsed from `location`. Powers Radar's exact-city →
  // state → region → country widening. `region` is one of six India macro-regions
  // (see server/src/data/locations.ts). Backfilled from `location`; indexes added
  // with the Radar retrieval engine.
  city                   String?
  state                  String?
  region                 String?
  country                String?
  age                    Int?
  height                 String?
  position               String?
  achievements           String[]
  phone                  String?
  contactEmail           String?   @map("contact_email")
  banner                 String?
  dateOfBirth            DateTime? @map("date_of_birth")
  verified               Boolean   @default(false)
  phoneVerified          Boolean   @default(false) @map("phone_verified")
  // Set on accounts created via admin bulk-provisioning with a temp password;
  // the client forces a password change on first login. Cleared once changed.
  mustResetPassword      Boolean   @default(false) @map("must_reset_password")
  messageNotifications   Boolean   @default(true) @map("message_notifications")
  showOnlineStatus       Boolean   @default(true) @map("show_online_status")
  messagingFollowersOnly Boolean   @default(false) @map("messaging_followers_only")
  disableAllComments     Boolean   @default(false) @map("disable_all_comments")
  // When on, this user browses privately — viewing someone's profile leaves no
  // trace (no view recorded, no "a scout viewed you" notification). Like LinkedIn.
  privateProfileViews    Boolean   @default(false) @map("private_profile_views")
  // ── Notification global controls (anti-spam + DPDP) ──
  notificationsPaused    Boolean   @default(false) @map("notifications_paused") // global "pause all"
  notifyQuietStart       Int?      @map("notify_quiet_start") // local hour 0-23 (email/push suppressed)
  notifyQuietEnd         Int?      @map("notify_quiet_end")
  notificationUnsubToken String?   @unique @map("notification_unsub_token") // one-click email unsubscribe
  // ── Referral / invite loop ──
  referralCode           String?   @unique @map("referral_code") // personal reusable invite link
  referredById           String?   @map("referred_by_id") // who invited this user (attribution)
  lastActiveAt           DateTime? @map("last_active_at")
  // Email the user is switching to. Set when they start a change; the Firebase
  // email only flips once they click the verification link, so `email` (below)
  // is reconciled to the token's verified email on the next /auth/me. UI shows
  // this as a "pending change" until then.
  pendingEmail           String?   @map("pending_email")
  // "Sign out of all devices": set when the user revokes sessions. The auth
  // middleware rejects any ID token whose auth_time predates this instant, so
  // revocation is immediate. Firebase refresh tokens are revoked at the same
  // time so no new tokens can be minted for the old sessions either.
  sessionsRevokedAt      DateTime? @map("sessions_revoked_at")
  // ── Account suspension (Trust & Safety) ──
  // App-level (we do NOT disable the Firebase account): a suspended user can
  // still authenticate, but the auth middleware blocks every route except the
  // appeal endpoints, so they land on /suspended and can contest it. On suspend
  // we also revoke sessions to end any active ones.
  suspended              Boolean   @default(false)
  suspendedAt            DateTime? @map("suspended_at")
  suspensionReason       String?   @map("suspension_reason")

  // Whether this profile is publicly discoverable (search, Scout Copilot,
  // rankings) and viewable by non-self. Under-13 accounts default to false;
  // only the guardian can turn it on. Everyone else defaults to true.
  discoverable Boolean @default(true)

  // ── Guardian management (athletes who registered under 13) ──
  guardianManaged        Boolean        @default(false) @map("guardian_managed")
  guardianEmail          String?        @map("guardian_email") // parent/academy email; retained for audit after handover
  handoverStatus         HandoverStatus @default(NONE) @map("handover_status")
  handoverTokenHash      String?        @map("handover_token_hash")
  handoverTokenExpiresAt DateTime?      @map("handover_token_expires_at")
  handoverRequestedAt    DateTime?      @map("handover_requested_at")
  handoverConsentAt      DateTime?      @map("handover_consent_at")

  // ── Guardian consent for admin/bulk-created under-13 accounts ──
  // When an admin creates an under-13 profile, the guardian must consent via an
  // emailed link before login credentials are issued (the account stays PENDING
  // and no temp password is delivered until then). Null for accounts that never
  // needed it (adults, 13+, or self-serve signup).
  guardianConsentStatus         GuardianConsentStatus? @map("guardian_consent_status")
  guardianConsentTokenHash      String?                @map("guardian_consent_token_hash")
  guardianConsentTokenExpiresAt DateTime?              @map("guardian_consent_token_expires_at")
  guardianConsentAt             DateTime?              @map("guardian_consent_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  highlights              Highlight[]
  posts                   Post[]
  postLikes               PostLike[]
  postComments            PostComment[]
  commentLikes            CommentLike[]
  postReposts             PostRepost[]
  postSaves               PostSave[]
  sentConnections         Connection[]             @relation("ConnectionSender")
  receivedConnections     Connection[]             @relation("ConnectionReceiver")
  followers               Follow[]                 @relation("FollowTarget")
  following               Follow[]                 @relation("FollowInitiator")
  captainOfTeams          Team[]                   @relation("TeamCaptain")
  coachOfTeams            Team[]                   @relation("TeamCoach")
  teamMemberships         TeamMember[]
  createdTournaments      Tournament[]
  organizerRoles          TournamentOrganizer[]    @relation("OrganizerRoles")
  organizersGranted       TournamentOrganizer[]    @relation("OrganizersGranted")
  organizerAuditsSubject  OrganizerAudit[]         @relation("OrganizerAuditsSubject")
  organizerAuditsActor    OrganizerAudit[]         @relation("OrganizerAuditsActor")
  basketballStats         BasketballStats[]
  footballStats           FootballStats[]
  cricketStats            CricketStats[]
  playerRankings          PlayerRanking[]
  announcements           Announcement[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  profileViewsMade        ProfileView[]            @relation("ProfileViewer")
  profileViewsReceived    ProfileView[]            @relation("ProfileViewed")
  invitesSent             Invite[]                 @relation("InvitesSent")
  pushSubscriptions       PushSubscription[]
  sentMessages            Message[]                @relation("MessageSender")
  sharedInMessages        Message[]                @relation("SharedProfileInMessage")
  conversationMemberships ConversationMember[]
  blocksMade              Block[]                  @relation("Blocker")
  blocksReceived          Block[]                  @relation("Blocked")
  reportsFiled            Report[]                 @relation("Reporter")
  reportsAgainst          Report[]                 @relation("Reported")
  endorsementsGiven       Endorsement[]            @relation("EndorsementCoach")
  endorsementsReceived    Endorsement[]            @relation("EndorsementAthlete")
  appeals                 Appeal[]                 @relation("AppealUser")
  appealsReviewed         Appeal[]                 @relation("AppealReviewer")
  moderationActions       ModerationAction[]       @relation("ModeratedUser")

  @@index([role])
  @@index([sport])
  @@index([sport, role])
  @@index([name]) // search: helps ORDER BY name; pg_trgm GIN (see prisma/sql) accelerates the ILIKE
}

// ─── Social: Follow & Connect ────────────────────────────

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowInitiator", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowTarget", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Connection {
  id         String           @id @default(uuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

// ─── Endorsements ────────────────────────────────────────
// A coach vouching for an athlete. Shown on the athlete's profile to
// strengthen it. One endorsement per coach → athlete pair.

model Endorsement {
  id        String   @id @default(uuid())
  coachId   String   @map("coach_id")
  athleteId String   @map("athlete_id")
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach   User @relation("EndorsementCoach", fields: [coachId], references: [id], onDelete: Cascade)
  athlete User @relation("EndorsementAthlete", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId])
  @@index([coachId])
}

// ─── Highlights ──────────────────────────────────────────

model Highlight {
  id                 String   @id @default(uuid())
  userId             String
  title              String
  description        String?
  videoUrl           String
  thumbnailUrl       String?
  sport              Sport
  tournamentId       String?
  tournamentLocation String?
  views              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([userId])
  @@index([sport])
  @@index([createdAt])
}

// ─── Posts ───────────────────────────────────────────────

model Post {
  id               String   @id @default(uuid())
  userId           String
  type             PostType
  content          String?
  mediaUrl         String?
  title            String?
  // Structured stat payload for PERFORMANCE posts (statValue, statLabel,
  // ratingDelta, rating, eyebrow, context). Null for every other post type.
  performance      Json?
  sport            Sport
  commentsDisabled Boolean  @default(false) @map("comments_disabled")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          PostMedia[]
  likes          PostLike[]
  comments       PostComment[]
  reposts        PostRepost[]
  saves          PostSave[]
  sharedMessages Message[]

  @@index([userId])
  @@index([sport])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model PostRepost {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostSave {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostMedia {
  id       String @id @default(uuid())
  postId   String
  url      String
  position Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ─── Teams ───────────────────────────────────────────────

model Team {
  id           String   @id @default(uuid())
  name         String
  sport        Sport
  captainId    String
  coachId      String?
  tournamentId String?
  logo         String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  captain                 User             @relation("TeamCaptain", fields: [captainId], references: [id])
  coach                   User?            @relation("TeamCoach", fields: [coachId], references: [id])
  tournament              Tournament?      @relation("TeamTournament", fields: [tournamentId], references: [id], onDelete: Cascade)
  members                 TeamMember[]
  tournamentRegistrations TournamentTeam[]
  homeMatches             Match[]          @relation("HomeTeam")
  awayMatches             Match[]          @relation("AwayTeam")

  @@index([sport])
  @@index([captainId])
  @@index([coachId])
  @@index([tournamentId])
  @@index([name]) // search
}

model TeamMember {
  id          String           @id @default(uuid())
  teamId      String
  userId      String
  role        TeamMemberRole   @default(PLAYER)
  status      TeamMemberStatus @default(PENDING)
  invitedAt   DateTime         @default(now())
  respondedAt DateTime?
  joinedAt    DateTime         @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, status])
}

// ─── Tournaments ─────────────────────────────────────────

model Tournament {
  id             String           @id @default(uuid())
  name           String
  sport          Sport
  category       String?
  description    String?
  venue          String?
  city           String?
  startDate      DateTime
  endDate        DateTime
  prizePool      Float?
  entryFee       Float?
  maxTeams       Int?
  ageCategory    String?
  genderCategory String?
  thumbnailUrl   String?
  status         TournamentStatus @default(UPCOMING)
  format         TournamentFormat @default(TEAM)
  minRosterSize  Int?
  maxRosterSize  Int?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  createdBy       User                  @relation(fields: [createdById], references: [id])
  organizers      TournamentOrganizer[] @relation("TournamentOrganizers")
  organizerAudits OrganizerAudit[]      @relation("TournamentOrganizerAudits")
  teams           TournamentTeam[]
  registeredTeams Team[]                @relation("TeamTournament")
  matches         Match[]
  highlights      Highlight[]
  rankings        PlayerRanking[]
  basketballStats BasketballStats[]
  footballStats   FootballStats[]
  cricketStats    CricketStats[]
  trackerSession  TrackerSession?

  @@index([sport])
  @@index([status])
  @@index([startDate])
  @@index([name]) // search
}

// ─── Stat Tracker (admin live tracking, decoupled from platform matches) ──

model TrackerSession {
  id           String               @id @default(uuid())
  tournamentId String               @unique
  sport        Sport
  format       TrackerBracketFormat
  groups       Json? // [{ id, name, teamIds[] }] for LEAGUE / MIXED
  bracket      Json? // knockout structure: { stages[], slots[] }
  config       Json? // { halfLengthSeconds, quarterSeconds, groupsCount, advancePerGroup, thirdPlace }
  roster       Json? // snapshot: [{ teamId, name, players:[{ userId, name, position, number }] }]
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    TrackerMatch[]
}

model TrackerMatch {
  id               String             @id @default(uuid())
  sessionId        String
  stage            String // "group" | "league" | "r32" | "r16" | "qf" | "sf" | "final" | "third_place"
  round            String? // display label e.g. "Group A", "Quarter-final"
  groupId          String?
  bracketSlot      String? // "qf-1"
  feedsInto        String? // "sf-1"
  orderIndex       Int                @default(0)
  homeTeamId       String? // platform Team id (nullable until seeded)
  awayTeamId       String?
  homeScore        Int                @default(0)
  awayScore        Int                @default(0)
  status           TrackerMatchStatus @default(SCHEDULED)
  scheduledAt      DateTime? // when the fixture is played (admin-set); null = TBC
  court            String? // court / pitch / venue label (admin-set); null = TBC
  state            Json? // full live state (clock, lineups, per-player stats, event/action log)
  publishedMatchId String? // platform Match id once published (updated in place on re-publish)
  startNotifiedAt  DateTime?          @map("start_notified_at") // "match starting soon" reminder sent (dedup)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  session TrackerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model TournamentTeam {
  id           String   @id @default(uuid())
  tournamentId String
  teamId       String
  registeredAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
}

// ─── Matches ─────────────────────────────────────────────

model Match {
  id           String      @id @default(uuid())
  tournamentId String
  homeTeamId   String
  awayTeamId   String
  homeScore    Int?
  awayScore    Int?
  round        String?
  matchDate    DateTime
  court        String? // court / pitch / venue label (from the fixture's schedule)
  status       MatchStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament      Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeTeam        Team              @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        Team              @relation("AwayTeam", fields: [awayTeamId], references: [id])
  basketballStats BasketballStats[]
  footballStats   FootballStats[]
  cricketStats    CricketStats[]

  @@index([tournamentId])
  @@index([matchDate])
}

// ─── Sport-Specific Stats ────────────────────────────────

model BasketballStats {
  id            String   @id @default(uuid())
  matchId       String
  userId        String
  tournamentId  String
  points        Int      @default(0)
  rebounds      Int      @default(0) // total (offensive + defensive)
  offRebounds   Int      @default(0) @map("off_rebounds")
  defRebounds   Int      @default(0) @map("def_rebounds")
  assists       Int      @default(0)
  steals        Int      @default(0)
  blocks        Int      @default(0)
  twoPointers   Int      @default(0) @map("two_pointers") // 2-pt field goals made
  threePointers Int      @default(0)
  freeThrows    Int      @default(0)
  turnovers     Int      @default(0)
  personalFouls Int      @default(0) @map("personal_fouls")
  minutesPlayed Float    @default(0)
  createdAt     DateTime @default(now())

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([matchId, userId])
  @@index([userId])
  @@index([tournamentId])
}

model FootballStats {
  id            String   @id @default(uuid())
  matchId       String
  userId        String
  tournamentId  String
  goals         Int      @default(0)
  assists       Int      @default(0)
  shots         Int      @default(0)
  passes        Int      @default(0)
  tackles       Int      @default(0)
  saves         Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  minutesPlayed Float    @default(0)
  createdAt     DateTime @default(now())

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([matchId, userId])
  @@index([userId])
  @@index([tournamentId])
}

model CricketStats {
  id           String   @id @default(uuid())
  matchId      String
  userId       String
  tournamentId String
  runs         Int      @default(0)
  ballsFaced   Int      @default(0)
  fours        Int      @default(0)
  sixes        Int      @default(0)
  wickets      Int      @default(0)
  oversBowled  Float    @default(0)
  runsConceded Int      @default(0)
  catches      Int      @default(0)
  runOuts      Int      @default(0)
  strikeRate   Float    @default(0)
  economy      Float    @default(0)
  createdAt    DateTime @default(now())

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([matchId, userId])
  @@index([userId])
  @@index([tournamentId])
}

// ─── Rankings ────────────────────────────────────────────

model PlayerRanking {
  id           String   @id @default(uuid())
  userId       String
  tournamentId String
  sport        Sport
  rank         Int
  score        Float
  category     String?
  region       String?
  calculatedAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId, category])
  @@index([tournamentId, sport])
  @@index([sport, category])
}

// ─── Announcements ───────────────────────────────────────

model Announcement {
  id        String           @id @default(uuid())
  userId    String
  title     String
  content   String
  type      AnnouncementType @default(GENERAL)
  sport     Sport?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sport])
  @@index([type])
  @@index([createdAt])
}

// ─── Notifications ───────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  read        Boolean          @default(false)
  referenceId String? // deep-link target (post/tournament/team/…)
  createdAt   DateTime         @default(now())

  // ── Channel-agnostic / anti-spam additions (all nullable-safe) ──
  actorId   String?   @map("actor_id") // who triggered it (for avatar + collapse)
  groupKey  String?   @map("group_key") // collapse key, e.g. "LIKE:post123"
  count     Int       @default(1) // collapsed count ("N people …")
  link      String? // precomputed client route
  emailedAt DateTime? @map("emailed_at") // set once an email is sent (dedup + digest)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") // bumps on collapse

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([userId, groupKey, read]) // collapse lookup
  @@index([userId, emailedAt]) // digest queue scan
}

// Profile views — one row per viewer per target per day (dedup bucket). Powers
// the "a scout viewed your profile" notification and the weekly views digest.
model ProfileView {
  id        String   @id @default(uuid())
  viewerId  String   @map("viewer_id")
  targetId  String   @map("target_id")
  day       String // YYYY-MM-DD, the dedup bucket
  createdAt DateTime @default(now()) @map("created_at")

  viewer User @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  target User @relation("ProfileViewed", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([viewerId, targetId, day])
  @@index([targetId, createdAt])
}

// Web push subscription (one per browser/device). deliverPush sends to these.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Contextual invite (carries who invited + what they're joining). The personal
// reusable link uses User.referralCode instead; both resolve at /join/:code.
model Invite {
  id           String     @id @default(uuid())
  code         String     @unique
  inviterId    String     @map("inviter_id")
  kind         InviteKind @default(GENERAL)
  teamId       String?    @map("team_id")
  tournamentId String?    @map("tournament_id")
  note         String?
  acceptedById String?    @map("accepted_by_id") // the user who signed up via it
  acceptedAt   DateTime?  @map("accepted_at")
  createdAt    DateTime   @default(now())

  inviter User @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}

// Sparse per-type preference OVERRIDES. A missing row means "use the code default"
// (see notificationCatalog.ts), so we never have to seed 20 rows per user.
model NotificationPreference {
  id     String           @id @default(uuid())
  userId String           @map("user_id")
  type   NotificationType
  inApp  Boolean          @default(true) @map("in_app")
  email  Boolean          @default(false)
  digest DigestFrequency  @default(INSTANT)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ─── Messaging ───────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isGroup Boolean @default(false) @map("is_group")
  name    String?
  teamId  String? @map("team_id")

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime? @map("last_read_at")
  isArchived     Boolean   @default(false) @map("is_archived")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id              String    @id @default(uuid())
  conversationId  String
  senderId        String
  content         String
  createdAt       DateTime  @default(now())
  deletedAt       DateTime? @map("deleted_at")
  sharedPostId    String?   @map("shared_post_id")
  sharedProfileId String?   @map("shared_profile_id")

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  sharedPost    Post?        @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)
  sharedProfile User?        @relation("SharedProfileInMessage", fields: [sharedProfileId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ─── Trust & Safety: Block / Report ──────────────────────

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

// What a report points at. USER is the original account-level report; the
// others flag a specific piece of content. reportedUserId always holds the
// author of the offending content (or the reported account for USER reports)
// so moderators can act on the person regardless of target type.
enum ReportTargetType {
  USER
  POST
  COMMENT
  MESSAGE
}

model Report {
  id             String           @id @default(uuid())
  reporterId     String
  reportedUserId String
  targetType     ReportTargetType @default(USER)
  // id of the reported post/comment/message; null for USER reports.
  targetId       String?
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  createdAt      DateTime         @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId])
  @@index([status])
  @@index([targetType, targetId])
}

// ─── Trust & Safety: Moderation actions + Appeals ────────
// A ModerationAction is the durable record of what a moderator did to a user
// (suspended them, removed a post). It's what a user "sees" when contesting a
// decision, and what an Appeal points at. Content removals are otherwise a hard
// delete, so without this the user would have nothing to appeal against.
enum ModerationActionType {
  SUSPEND
  UNSUSPEND
  CONTENT_REMOVED
}

model ModerationAction {
  id         String               @id @default(uuid())
  userId     String // the affected user
  actorId    String? // the admin who acted (null if system)
  type       ModerationActionType
  targetType String? // for CONTENT_REMOVED: POST / COMMENT / MESSAGE
  targetId   String?
  reason     String? // moderator-facing reason / guideline cited
  detail     String? // short snapshot the user sees ("your post: …")
  createdAt  DateTime             @default(now())

  user    User     @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  appeals Appeal[] @relation("AppealAction")

  @@index([userId])
  @@index([type])
}

enum AppealKind {
  ACCOUNT_SUSPENSION
  CONTENT_REMOVAL
}

enum AppealStatus {
  PENDING // submitted, not yet looked at
  REVIEWING // an admin is on it
  GRANTED // appeal upheld — action reversed
  DENIED // appeal rejected — action stands
}

model Appeal {
  id           String       @id @default(uuid())
  userId       String
  kind         AppealKind
  actionId     String? // the ModerationAction being contested (if recorded)
  subjectLabel String? // snapshot of what's being appealed (reason / content)
  message      String // the user's own appeal text
  status       AppealStatus @default(PENDING)
  reviewNote   String? // admin's note on resolution
  reviewedById String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  user     User              @relation("AppealUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?             @relation("AppealReviewer", fields: [reviewedById], references: [id])
  action   ModerationAction? @relation("AppealAction", fields: [actionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([kind, status])
}

// ─── Tournament organiser access (tournament-scoped, NOT platform admin) ─────
// A user assigned to organise a SPECIFIC tournament. Grants that tournament's
// management powers only, enforced server-side in middleware/tournamentAccess.ts
// (super-admin OR assigned organiser). Many organisers per tournament; a user
// may organise many tournaments. Wholly distinct from platform ADMIN.
model TournamentOrganizer {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  addedById    String?  @map("added_by_id") // the super-admin who granted it
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation("TournamentOrganizers", fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("OrganizerRoles", fields: [userId], references: [id], onDelete: Cascade)
  addedBy    User?      @relation("OrganizersGranted", fields: [addedById], references: [id])

  @@unique([tournamentId, userId])
  @@index([userId])
  @@index([tournamentId])
}

enum OrganizerAuditAction {
  GRANTED
  REVOKED
}

// Immutable audit trail for organiser access grants/revokes. Access itself lives
// in TournamentOrganizer (which is deleted on revoke); THIS table is the durable
// record of who did what, to whom, and when — for a platform holding minors' data.
// `detail` snapshots the names/email so a row stays legible even if the tournament
// or user is later deleted. Follows the ModerationAction pattern.
model OrganizerAudit {
  id             String               @id @default(uuid())
  tournamentId   String               @map("tournament_id")
  userId         String               @map("user_id") // the organiser granted/revoked
  actorId        String?              @map("actor_id") // the super-admin who acted (null if system)
  action         OrganizerAuditAction
  accountCreated Boolean              @default(false) @map("account_created") // grant that also created a new account
  detail         String? // snapshot: "Priya Rao (p@x.in) · Don Bosco Cup 2026"
  createdAt      DateTime             @default(now()) @map("created_at")

  tournament Tournament @relation("TournamentOrganizerAudits", fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation("OrganizerAuditsSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?      @relation("OrganizerAuditsActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([userId])
}

// Auth tokens (refresh, email-verification, password-reset) are managed by
// Firebase Authentication. Firebase stores credentials, issues short-lived ID
// tokens, and sends verification/reset emails automatically.
