{
  "hosting": {
    "public": "apps/web/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/athletes",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/athletes/**",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/sitemap-athletes.xml",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/faq",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/about",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/safety",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/community-guidelines",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/learn",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/learn/**",
        "run": { "serviceId": "allfor1-web", "region": "asia-south1" }
      },
      {
        "source": "/og/**",
        "run": { "serviceId": "allfor1-api", "region": "asia-south1" }
      },
      {
        "source": "/s/**",
        "run": { "serviceId": "allfor1-api", "region": "asia-south1" }
      },
      {
        "source": "**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(home|explore|tournaments|rankings|announcements|messages|notifications|grow|admin|radar|settings|support|saved|profile|teams|login|register|onboarding|verify-email|verify-pending|forgot-password|reset-password|handover|guardian-consent|force-password-reset|unsubscribe|invite|join)",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      },
      {
        "source": "/@(home|explore|tournaments|rankings|announcements|messages|notifications|grow|admin|radar|settings|support|saved|profile|teams|login|register|onboarding|verify-email|verify-pending|forgot-password|reset-password|handover|guardian-consent|force-password-reset|unsubscribe|invite|join)/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      }
    ]
  }
}
